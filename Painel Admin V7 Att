--========================================================
-- PERSONAGEM RENASCIDO
--========================================================

Player.CharacterAdded:Connect(function(char)
    StopFly()

    SpinOn = false
    NoclipOn = false
    Invisible = false
    GhostOn = false

    SavedCollision = {}
    OriginalTransparency = {}
    GhostOriginal = {}

    CharacterSetup(char)

    task.spawn(function()
        local newRoot = char:WaitForChild("HumanoidRootPart",10)

        if newRoot and ResetPending and PendingReturnCFrame then
            task.wait(0.3)

            if char.Parent then
                char:PivotTo(PendingReturnCFrame)
                Notify("Personagem voltou à posição anterior!")
            end

            PendingReturnCFrame = nil
            ResetPending = false
        end
    end)

    task.wait(0.3)

    AnimateScript = char:FindFirstChild("Animate")

    if AnimateScript then
        AnimateScript.Disabled = false
    end

    FlyButton.Text = "FLY: OFF"
    FlyButton.Visible = false
end)

