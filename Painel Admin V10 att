--========================================================
-- EXECUTAR COMANDOS
--========================================================

ExecuteCommand = function(message)
    if message:sub(1,#Prefix) ~= Prefix then
        return
    end

    local args = {}

    for word in message:sub(#Prefix+1):gmatch("%S+") do
        table.insert(args,word:lower())
    end

    local cmd = table.remove(args,1)

    if args[1] == "me" then
        table.remove(args,1)
    end

    if cmd == "fly" then
        if args[1] then
            SetFlySpeed(args[1])
        end

        FlyButton.Visible = true
        StartFly()

    elseif cmd == "unfly" then
        FlyResumeAfterRespawn = false
        FlyButtonVisibleAfterRespawn = false
        StopFly()
        FlyButton.Visible = false

    elseif cmd == "speed" then
        SetSpeed(args[1])

    elseif cmd == "jump" then
        SetJump(args[1])

    elseif cmd == "to" then
        TeleportToPlayer(table.concat(args," "))

    elseif cmd == "spin" then
        StartSpin(args[1])

    elseif cmd == "unspin" then
        StopSpin()

    elseif cmd == "noclip" then
        StartNoclip()

    elseif cmd == "clip" then
        StopNoclip()

    elseif cmd == "invisible" then
        SetInvisible(true)

    elseif cmd == "visible" then
        SetInvisible(false)

    elseif cmd == "ghost" then
        SetGhost(true)

    elseif cmd == "unghost" then
        SetGhost(false)

    elseif cmd == "fire" then
        FireEffect()

    elseif cmd == "unfire" then
        RemoveFire()

    elseif cmd == "sparkles" then
        SparkleEffect()

    elseif cmd == "unsparkles" then
        RemoveSparkles()

    elseif cmd == "sit" then
        if Humanoid then
            Humanoid.Sit = true
        end

    elseif cmd == "dance" then
        Notify("Animação depende do jogo")

    elseif cmd == "freeze" then
        if Root then
            Root.Anchored = true
            Notify("Personagem congelado")
        end

    elseif cmd == "unfreeze" then
        if Root then
            Root.Anchored = false
            Notify("Personagem descongelado")
        end

    elseif cmd == "reset"
    or cmd == "respawn"
    or cmd == "refresh"
    or cmd == "re" then

        ResetCharacter()

    elseif cmd == "rejoin" then
        local success,err = pcall(function()
            TeleportService:Teleport(game.PlaceId,Player)
        end)

        if not success then
            Notify("Não foi possível entrar novamente")
            warn(err)
        end

    elseif cmd == "serverhop" then
        ServerHop()

    elseif cmd == "dex" then
        OpenDex()

    elseif cmd == "int" then
        SetInstantInteraction(true)

    elseif cmd == "uint" then
        SetInstantInteraction(false)

    elseif cmd == "cmds" then
        ShowCommands()

    elseif cmd == "cmdbox" then
        ShowCmdBox()

    else
        Notify("Comando desconhecido: "..tostring(cmd))
    end
end

