Player.CharacterAdded:Connect(function(char)
    local resumeFly = FlyResumeAfterRespawn or FlyOn
    local keepFlyButton = FlyButtonVisibleAfterRespawn
        or FlyButton.Visible
        or resumeFly

    StopFly()

    FlyResumeAfterRespawn = false
    FlyButtonVisibleAfterRespawn = false

    SpinOn = false
    NoclipOn = false
    Invisible = false
    GhostOn = false

    SavedCollision = {}
    OriginalTransparency = {}
    GhostOriginal = {}

    CharacterSetup(char)

    FlyButton.Visible = keepFlyButton
    FlyButton.Text = "FLY: OFF"

    task.spawn(function()
        local newRoot = char:WaitForChild("HumanoidRootPart",10)

        if newRoot and ResetPending and PendingReturnCFrame then
            task.wait(0.3)

            if char.Parent then
                char:PivotTo(PendingReturnCFrame)
                Notify("Personagem voltou à posição anterior!")
            end

            PendingReturnCFrame = nil
            ResetPending = false
        end

        if resumeFly and char.Parent and Humanoid and Humanoid.Health > 0 then
            task.wait(0.2)
            FlyButton.Visible = true
            StartFly()
        end
    end)

    task.wait(0.3)

    AnimateScript = char:FindFirstChild("Animate")

    if AnimateScript and not resumeFly then
        AnimateScript.Disabled = false
    end

    if not resumeFly then
        FlyButton.Text = "FLY: OFF"
    end
end)

