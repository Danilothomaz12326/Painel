--========================================================
-- INSTANT INTERACTION
--========================================================

local function ApplyInstantPrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then
        return
    end

    if SavedPromptDurations[prompt] == nil then
        SavedPromptDurations[prompt] = {
            HoldDuration = prompt.HoldDuration,
            Enabled = prompt.Enabled
        }
    end

    pcall(function()
        prompt.HoldDuration = 0
    end)
end

local function SetInstantInteraction(state)
    if state then
        if InstantInteractionOn then
            Notify("Instant Interaction já está ativado")
            return
        end

        InstantInteractionOn = true

        for _, object in ipairs(workspace:GetDescendants()) do
            if object:IsA("ProximityPrompt") then
                ApplyInstantPrompt(object)
            end
        end

        if PromptAddedConnection then
            PromptAddedConnection:Disconnect()
        end

        PromptAddedConnection = workspace.DescendantAdded:Connect(function(object)
            if InstantInteractionOn and object:IsA("ProximityPrompt") then
                ApplyInstantPrompt(object)
            end
        end)

        Notify("Instant Interaction ativado")
    else
        if not InstantInteractionOn and next(SavedPromptDurations) == nil then
            Notify("Instant Interaction já está desativado")
            return
        end

        InstantInteractionOn = false

        if PromptAddedConnection then
            PromptAddedConnection:Disconnect()
            PromptAddedConnection = nil
        end

        -- Desativa e reativa cada prompt para limpar qualquer estado
        -- de interação que tenha ficado preso durante o modo instantâneo.
        for prompt, oldData in pairs(SavedPromptDurations) do
            if prompt and prompt.Parent then
                pcall(function()
                    prompt.Enabled = false
                    prompt.HoldDuration = oldData.HoldDuration
                    prompt.Enabled = oldData.Enabled
                end)
            end
        end

        SavedPromptDurations = {}
        Notify("Instant Interaction desativado; prompts restaurados")
    end
end

