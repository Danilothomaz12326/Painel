local function StartNoclip()
    if not Character then return end

    NoclipOn = true
    SavedCollision = {}

    for _,part in ipairs(Character:GetDescendants()) do
        if part:IsA("BasePart") then
            SavedCollision[part] = part.CanCollide
        end
    end

    Notify("Noclip ativado")
end

local function StopNoclip()
    NoclipOn = false

    for part,oldValue in pairs(SavedCollision) do
        if part and part.Parent then
            part.CanCollide = oldValue
        end
    end

    SavedCollision = {}
    Notify("Noclip desativado")
end

--========================================================
-- INVISIBLE
--========================================================

local function SetInvisible(state)
    if not Character then return end

    Invisible = state

    if state then
        OriginalTransparency = {}

        for _,obj in ipairs(Character:GetDescendants()) do
            if obj:IsA("BasePart") then
                OriginalTransparency[obj] = {
                    Transparency = obj.Transparency,
                    LocalTransparencyModifier =
                        obj.LocalTransparencyModifier
                }

                obj.LocalTransparencyModifier = 1

            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                OriginalTransparency[obj] = {
                    Transparency = obj.Transparency
                }

                obj.Transparency = 1
            end
        end

        Notify("Invisibilidade local ativada")
    else
        for obj,old in pairs(OriginalTransparency) do
            if obj and obj.Parent then
                if obj:IsA("BasePart") then
                    obj.Transparency = old.Transparency
                    obj.LocalTransparencyModifier =
                        old.LocalTransparencyModifier

                elseif obj:IsA("Decal") or obj:IsA("Texture") then
                    obj.Transparency = old.Transparency
                end
            end
        end

        OriginalTransparency = {}
        Notify("Aparência restaurada")
    end
end--========================================================
-- GHOST 90%
--========================================================

local function SetGhost(state)
    if not Character then return end

    GhostOn = state

    if state then
        GhostOriginal = {}

        for _,obj in ipairs(Character:GetDescendants()) do
            if obj:IsA("BasePart") then
                GhostOriginal[obj] = {
                    Transparency = obj.Transparency,
                    LocalTransparencyModifier =
                        obj.LocalTransparencyModifier
                }

                obj.Transparency = 0.9
                obj.LocalTransparencyModifier = 0

            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                GhostOriginal[obj] = {
                    Transparency = obj.Transparency
                }

                obj.Transparency = 0.9
            end
        end

        Notify("Ghost ativado: 90% transparente")
    else
        for obj,old in pairs(GhostOriginal) do
            if obj and obj.Parent then
                if obj:IsA("BasePart") then
                    obj.Transparency = old.Transparency
                    obj.LocalTransparencyModifier =
                        old.LocalTransparencyModifier

                elseif obj:IsA("Decal") or obj:IsA("Texture") then
                    obj.Transparency = old.Transparency
                end
            end
        end

        GhostOriginal = {}
        Notify("Ghost desativado")
    end
end

