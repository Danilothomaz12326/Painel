local function StopFly()
    FlyOn = false

    if FlyConnection then
        FlyConnection:Disconnect()
        FlyConnection = nil
    end

    if Velocity then Velocity:Destroy() end
    if Orientation then Orientation:Destroy() end
    if Attachment then Attachment:Destroy() end

    Velocity = nil
    Orientation = nil
    Attachment = nil

    RestoreFlightAnimation()

    FlyButton.Text = "FLY: OFF"
    FlyButton.BackgroundColor3 = Color3.fromRGB(35,35,35)
end

--========================================================
-- ATIVAR VOO
--========================================================

local function StartFly()
    if FlyOn or not Root or not Humanoid then return end

    FlyOn = true

    AnimateScript = Character:FindFirstChild("Animate")

    if AnimateScript then
        AnimateWasDisabled = AnimateScript.Disabled
        AnimateScript.Disabled = true
    end

    OldAutoRotate = Humanoid.AutoRotate
    Humanoid.AutoRotate = false

    for _,track in ipairs(Humanoid:GetPlayingAnimationTracks()) do
        track:Stop(0.15)
    end

    Attachment = Instance.new("Attachment")
    Attachment.Parent = Root

    Velocity = Instance.new("LinearVelocity")
    Velocity.Attachment0 = Attachment
    Velocity.RelativeTo = Enum.ActuatorRelativeTo.World
    Velocity.MaxForce = math.huge
    Velocity.VectorVelocity = Vector3.zero
    Velocity.Parent = Root

    Orientation = Instance.new("AlignOrientation")
    Orientation.Attachment0 = Attachment
    Orientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
    Orientation.Responsiveness = 8
    Orientation.MaxTorque = math.huge
    Orientation.Parent = Root

    FlyConnection = RunService.Heartbeat:Connect(function()
        if not FlyOn or not Root or not Humanoid then
            StopFly()
            return
        end

        local camera = workspace.CurrentCamera
        if not camera then return end

        local move = Humanoid.MoveDirection
        local look = camera.CFrame.LookVector
        local right = camera.CFrame.RightVector

        local flatLook = Vector3.new(look.X,0,look.Z)
        local flatRight = Vector3.new(right.X,0,right.Z)

        if flatLook.Magnitude > 0 then
            flatLook = flatLook.Unit
        end

        if flatRight.Magnitude > 0 then
            flatRight = flatRight.Unit
        end

        local forwardAmount = move:Dot(flatLook)
        local rightAmount = move:Dot(flatRight)

        local direction =
            look * forwardAmount +
            right * rightAmount

        if direction.Magnitude > 1 then
            direction = direction.Unit
        end

        -- Valor 1 mantém a velocidade rápida padrão do voo.
        local effectiveFlySpeed = (FlySpeed == 1) and 80 or FlySpeed
        Velocity.VectorVelocity = direction * effectiveFlySpeed

        Orientation.CFrame = CFrame.lookAt(
            Vector3.zero,
            look
        )
    end)

    FlyButton.Text = "FLY: ON"
    FlyButton.BackgroundColor3 = Color3.fromRGB(25,120,65)
end

FlyButton.MouseButton1Click:Connect(function()
    if FlyOn then
        StopFly()
    else
        StartFly()
    end
end)

