--========================================================
-- TELEPORTE ATÉ JOGADOR
--========================================================

local function TeleportToPlayer(query)
    if not query or query == "" then
        Notify("Use :to nome")
        return
    end

    query = query:gsub("^@", ""):lower()

    local matches = {}

    for _,target in ipairs(Players:GetPlayers()) do
        if target ~= Player then
            local username = target.Name:lower()
            local display = target.DisplayName:lower()

            if username == query or display == query then
                matches = {target}
                break
            end
        end
    end

    if #matches == 0 then
        for _,target in ipairs(Players:GetPlayers()) do
            if target ~= Player then
                local username = target.Name:lower()
                local display = target.DisplayName:lower()

                if username:sub(1,#query) == query
                or display:sub(1,#query) == query then
                    table.insert(matches,target)
                end
            end
        end
    end

    if #matches == 0 then
        for _,target in ipairs(Players:GetPlayers()) do
            if target ~= Player then
                local username = target.Name:lower()
                local display = target.DisplayName:lower()

                if username:find(query,1,true)
                or display:find(query,1,true) then
                    table.insert(matches,target)
                end
            end
        end
    end

    if #matches == 0 then
        Notify("Jogador não encontrado")
        return
    end

    if #matches > 1 then
        Notify("Nome ambíguo! Digite mais letras.")
        return
    end

    local target = matches[1]
    local targetChar = target.Character

    local targetRoot = targetChar
        and targetChar:FindFirstChild("HumanoidRootPart")

    if not targetRoot or not Root or not Character then
        Notify("Personagem indisponível")
        return
    end

    Character:PivotTo(
        targetRoot.CFrame * CFrame.new(0,0,3)
    )

    Notify("Teleportado até "..target.DisplayName)
end

