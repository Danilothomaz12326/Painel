local ProfileRequestId = 0

local function ShowProfile(target)
    if not target then return end

    ProfileRequestId = ProfileRequestId + 1
    local requestId = ProfileRequestId
    local targetUserId = target.UserId

    local generatedName = RandomNames[math.random(1,#RandomNames)]
    local generatedPlace = RandomBrazilLocations[
        math.random(1,#RandomBrazilLocations)
    ]

    ProfileDisplay.Text = target.DisplayName
    ProfileUsername.Text = "@" .. target.Name
    ProfileUserId.Text = tostring(target.UserId)
    ProfileAccountAge.Text = tostring(target.AccountAge) .. " dias"
    ProfileCreated.Text = "Carregando..."
    ProfileRegion.Text = generatedPlace.region .. " (aleatória)"
    ProfileCity.Text = generatedPlace.city .. " (aleatória)"
    ProfileLocation.Text = generatedPlace.city .. ", " .. generatedPlace.state
    ProfilePhone.Text = "Não informado"
    ProfileCPF.Text = "Não informado"
    ProfileFullName.Text = generatedName .. " (aleatório)"
    ProfileOrigin.Text = "Não verificada"
    ProfileStatus.Text = "No servidor"

    ProfileAvatar.Image = ""

    task.spawn(function()
        local success, image = pcall(function()
            return Players:GetUserThumbnailAsync(
                targetUserId,
                Enum.ThumbnailType.HeadShot,
                Enum.ThumbnailSize.Size150x150
            )
        end)

        if success and ProfileAvatar.Parent and requestId == ProfileRequestId then
            ProfileAvatar.Image = image
        end
    end)

    task.spawn(function()
        local success, response = pcall(function()
            return game:HttpGet(
                "https://users.roblox.com/v1/users/" .. tostring(targetUserId)
            )
        end)

        if success then
            local decoded, data = pcall(function()
                return HttpService:JSONDecode(response)
            end)

            if decoded and data and data.created and requestId == ProfileRequestId then
                local dateSuccess, formatted = pcall(function()
                    return DateTime.fromIsoDate(data.created)
                        :FormatUniversalTime("DD/MM/YYYY", "en-us")
                end)

                ProfileCreated.Text = dateSuccess and formatted or "Não disponível"
            elseif requestId == ProfileRequestId then
                ProfileCreated.Text = "Não disponível"
            end
        elseif requestId == ProfileRequestId then
            ProfileCreated.Text = "Não disponível"
        end
    end)

    ProfileBubble.Visible = false
    ProfilePanel.Visible = true
end

local function ExecuteProfileCommand(message)
    local command, query = message:match("^%s*!(%S+)%s*(.-)%s*$")

    if not command or command:lower() ~= "profile" then
        return false
    end

    query = (query or ""):gsub("^@", ""):lower()

    if query == "" or query == "me" then
        ShowProfile(Player)
        return true
    end

    local allPlayers = Players:GetPlayers()
    local target = nil

    for _, candidate in ipairs(allPlayers) do
        if candidate.Name:lower() == query
        or candidate.DisplayName:lower() == query then
            target = candidate
            break
        end
    end

    if not target then
        local matches = {}

        for _, candidate in ipairs(allPlayers) do
            if candidate.Name:lower():sub(1,#query) == query
            or candidate.DisplayName:lower():sub(1,#query) == query then
                table.insert(matches,candidate)
            end
        end

        if #matches == 1 then
            target = matches[1]
        elseif #matches > 1 then
            Notify("Vários jogadores encontrados. Digite mais letras.")
            return true
        end
    end

    if not target then
        local matches = {}

        for _, candidate in ipairs(allPlayers) do
            if candidate.Name:lower():find(query,1,true)
            or candidate.DisplayName:lower():find(query,1,true) then
                table.insert(matches,candidate)
            end
        end

        if #matches == 1 then
            target = matches[1]
        elseif #matches > 1 then
            Notify("Vários jogadores encontrados. Digite mais letras.")
            return true
        end
    end

    if not target then
        Notify("Jogador não encontrado neste servidor")
        return true
    end

    ShowProfile(target)
    return true
end

